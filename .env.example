# Database (PostgreSQL, e.g. Neon). DATABASE_URL is the pooled connection used by
# the app; DIRECT_URL is the direct (non-pooled) connection Prisma uses for schema changes.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth
AUTH_SECRET="change-me-in-production"

# Data-at-rest encryption key (32 bytes, base64). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="change-me-32-byte-base64-key"

# Session cookie name (optional)
SESSION_COOKIE="reproai_session"

# Exact Capacitor WebView origins allowed to call the API with a bearer token.
CAPACITOR_ALLOWED_ORIGINS="https://localhost,capacitor://localhost"

# ML service — local Python service (see ml-service/README.md to run it)
# When Azure ML is available, replace with the Azure endpoint URL.
ML_API_URL="http://localhost:8000"

# App
NEXT_PUBLIC_DEFAULT_LOCALE="en"


# =============================================================================
# LLM PROVIDER — priority: Azure OpenAI → Groq → 503 error
# Fill in ONE of the two sections below. Azure is preferred for production;
# Groq (free tier) is the automatic fallback while Azure credits are pending.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Azure AI Foundry / Azure OpenAI (preferred — activate when credits arrive)
#    Leave all blank to skip Azure and fall through to Groq.
# -----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=""              # e.g. https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=""               # API key, OR use Entra ID (leave key blank)
AZURE_OPENAI_DEPLOYMENT=""            # chat model deployment name, e.g. gpt-4o
AZURE_OPENAI_API_VERSION="2024-10-21"

# Optional: Retrieval-Augmented Generation via Azure AI Search.
# When blank, the built-in local WHO guidelines library is used instead.
AZURE_SEARCH_ENDPOINT=""              # e.g. https://<search>.search.windows.net
AZURE_SEARCH_API_KEY=""
AZURE_SEARCH_INDEX=""                 # index containing guideline documents

# Optional: external MCP (Model Context Protocol) server exposing extra tools to
# the agent. Leave blank to use only built-in tools. Streamable HTTP transport.
MCP_SERVER_URL=""                   # e.g. https://<host>/mcp
MCP_SERVER_TOKEN=""                 # optional bearer token for the MCP server

# -----------------------------------------------------------------------------
# 2. Azure Health Data Services (FHIR) & Malaffi HIE (Abu Dhabi)
#    Azure Health Data Services is not offered in UAE North (checked 18 Nov 2026; nearest:
#    Qatar Central). Use a FHIR sandbox with synthetic data only; do not describe it as
#    UAE-resident. Malaffi is the Abu Dhabi HIE; not connected in this prototype.
# -----------------------------------------------------------------------------
# Inbound webhook key for clinic LIS & hospital EHR push (/api/integrations/ehr).
# At least 32 random characters (e.g. `openssl rand -hex 32`). Empty = endpoint disabled.
# It is never replaced by AUTH_SECRET.
REPROAI_PARTNER_API_KEY=""

# Outbound Azure API for FHIR / Azure Health Data Services endpoint
AZURE_FHIR_ENDPOINT=""              # e.g. https://<workspace>.fhir.azurehealthcareapis.com
AZURE_FHIR_TENANT_ID=""             # Azure Entra ID Tenant ID
AZURE_FHIR_CLIENT_ID=""             # App Registration Client ID with FHIR Data Reader
AZURE_FHIR_CLIENT_SECRET=""         # App Registration Client Secret
# All four are needed: the app exchanges the client secret for an Entra ID token.

# Abu Dhabi Health Information Exchange (Malaffi HIE / Sahhatna)
MALAFFI_HIE_GATEWAY_URL=""          # e.g. https://hie-gateway.malaffi.ae/fhir/r4
MALAFFI_FACILITY_ID=""              # e.g. DOH-CLINIC-AUH-8842

# -----------------------------------------------------------------------------
# 3. Groq (free tier — no credit card required)
#    Get a free key at https://console.groq.com
#    Used automatically when Azure credentials above are not set.
# -----------------------------------------------------------------------------
GROQ_API_KEY=""                       # e.g. gsk_...
GROQ_MODEL="openai/gpt-oss-120b"  # or mixtral-8x7b-32768, gemma2-9b-it

# -----------------------------------------------------------------------------
# Demo login (optional). Shows Clinician / Female / Male / Couple demo buttons
# on the login page that sign in without a password. Only enable on demo
# deployments: anyone can use them, and the demo clinician sees every case.
# Create the patient personas with `npm run demo:setup` (needs the ML service);
# the clinician comes from `npm run prisma:seed`.
# -----------------------------------------------------------------------------
DEMO_LOGIN_ENABLED="false"

# Invitation emails via Nodemailer SMTP (optional). Without SMTP_HOST the clinician shares the link by hand.
# Use your clinic SMTP relay or a UAE-hosted SMTP service (synthetic data only for external relays; see docs/data-governance.md).
SMTP_HOST=""                          # e.g. "smtp.gmail.com" or clinic SMTP host
SMTP_PORT="587"                       # 587 (STARTTLS) or 465 (SSL/TLS)
SMTP_SECURE="false"                   # "true" for port 465, "false" for 587
SMTP_USER=""                          # SMTP username / email
SMTP_PASS=""                          # SMTP password or app password
EMAIL_FROM=""                         # e.g. "ReproAI <invites@your-domain>"
# Public base URL for links in emails; defaults to the request origin.
APP_URL=""                            # e.g. "https://reproai.example"
DEMO_CLINICIAN_EMAIL="clinician@reproai.dev"
DEMO_FEMALE_EMAIL="demo.female@reproai.dev"
DEMO_MALE_EMAIL="demo.male@reproai.dev"
DEMO_COUPLE_EMAIL="demo.couple@reproai.dev"

# Clinician accounts are provisioned, not self-registered. Set to "true" only to
# bootstrap the first clinician on a fresh deployment, then remove it.
ALLOW_CLINICIAN_SIGNUP="false"
