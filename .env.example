# Database
DATABASE_URL="file:./dev.db"

# Auth
AUTH_SECRET="change-me-in-production"

# Data-at-rest encryption key (32 bytes, base64). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="change-me-32-byte-base64-key"

# Session cookie name (optional)
SESSION_COOKIE="reproai_session"

# ML service — local Python service (see ml-service/README.md to run it)
# When Azure ML is available, replace with the Azure endpoint URL.
ML_API_URL="http://localhost:8000"

# App
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# Economic impact metrics
# Average IVF cycle cost in USD (used for healthcare savings calculation)
IVF_CYCLE_COST="12000"

# =============================================================================
# LLM PROVIDER — priority: Azure OpenAI → Groq → 503 error
# Fill in ONE of the two sections below. Azure is preferred for production;
# Groq (free tier) is the automatic fallback while Azure credits are pending.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Azure AI Foundry / Azure OpenAI (preferred — activate when credits arrive)
#    Leave all blank to skip Azure and fall through to Groq.
# -----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=""              # e.g. https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=""               # API key, OR use Entra ID (leave key blank)
AZURE_OPENAI_DEPLOYMENT=""            # chat model deployment name, e.g. gpt-4o
AZURE_OPENAI_API_VERSION="2024-10-21"

# Optional: Retrieval-Augmented Generation via Azure AI Search.
# When blank, the built-in local WHO guidelines library is used instead.
AZURE_SEARCH_ENDPOINT=""              # e.g. https://<search>.search.windows.net
AZURE_SEARCH_API_KEY=""
AZURE_SEARCH_INDEX=""                 # index containing guideline documents

# -----------------------------------------------------------------------------
# 2. Groq (free tier — no credit card required)
#    Get a free key at https://console.groq.com
#    Used automatically when Azure credentials above are not set.
# -----------------------------------------------------------------------------
GROQ_API_KEY=""                       # e.g. gsk_...
GROQ_MODEL="llama-3.3-70b-versatile"  # or mixtral-8x7b-32768, gemma2-9b-it
