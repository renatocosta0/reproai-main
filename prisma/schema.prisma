// ReproAI data model. No seed/mock data is provided; the database starts empty.
// NOTE: SQLite does not support native enums. Role and FollowUpStatus are stored
// as plain String columns. Valid values: Role = "PATIENT" | "CLINICIAN";
// FollowUpStatus = "ALERT_RAISED" | "APPOINTMENT_SCHEDULED" | "IN_FOLLOW_UP" | "CLOSED" | "LOST"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  /// One of: PATIENT | CLINICIAN
  role      String
  consentAt DateTime?
  createdAt DateTime @default(now())
  couple    Couple?  @relation(fields: [coupleId], references: [id])
  coupleId  String?

  // Individual-First architecture relations
  patientProfile      Patient?
  observations        Observation[]
  predictions         Prediction[]
  sentPairingInvites  PairingInvite[] @relation("SentPairingInvites")
}

model Couple {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  users        User[]
  patients     Patient[]
  predictions  Prediction[]
  observations Observation[]
  followUps    FollowUp[]
  invitations  Invitation[]
}

model Patient {
  id        String   @id @default(cuid())
  // Individual owner link
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  // Optional shared couple link (when paired)
  coupleId  String?
  couple    Couple?  @relation(fields: [coupleId], references: [id])

  name      String?
  // Clinical attributes used by the model
  sex             String?  // "female" | "male"
  age             Int?
  bmi             Float?
  amh             Float?
  spermCount      Float?
  pcosHistory     Boolean?
  infertilityDurationMonths Int?
  priorCycles     Int?
  antralFollicleCount       Int?
  cycleRegularity           String? // "REGULAR" | "IRREGULAR" | "AMENORRHEA"
  preservationIntent        Boolean? @default(false)
  createdAt       DateTime @default(now())
}

model Observation {
  id        String   @id @default(cuid())
  // Individual owner
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  // Optional couple association
  coupleId  String?
  couple    Couple?  @relation(fields: [coupleId], references: [id])

  // FHIR-aligned: code + value + unit (e.g. body temperature, sleep hours)
  code      String
  value     Float
  unit      String?
  effectiveAt DateTime @default(now())
}

model Prediction {
  id            String   @id @default(cuid())
  // Individual owner
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  // Optional couple association
  coupleId      String?
  couple        Couple?  @relation(fields: [coupleId], references: [id])

  scope         String   @default("COUPLE") // "INDIVIDUAL" | "COUPLE"
  probability   Float
  confidenceLow Float?
  confidenceHigh Float?
  tier          String?  // "OPTIMAL" | "AGE_APPROPRIATE" | "REDUCED_RESERVE" | "CLINICAL_ATTENTION_NEEDED"
  preservationGuidance String?
  // JSON string of feature importances returned by the ML service
  factors       String?
  modelVersion  String?
  createdAt     DateTime @default(now())
}

model FollowUp {
  id        String         @id @default(cuid())
  couple    Couple         @relation(fields: [coupleId], references: [id])
  coupleId  String
  /// One of: ALERT_RAISED | APPOINTMENT_SCHEDULED | IN_FOLLOW_UP | CLOSED | LOST
  status    String @default("ALERT_RAISED")
  note      String?
  updatedAt DateTime       @updatedAt
  createdAt DateTime       @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  resource  String
  createdAt DateTime @default(now())
}

model Invitation {
  id          String    @id @default(cuid())
  coupleId    String
  couple      Couple    @relation(fields: [coupleId], references: [id])
  femaleEmail String
  maleEmail   String?
  token       String    @unique
  notes       String?
  invitedBy   String    // Clinician userId
  status      String    @default("PENDING") // PENDING | ACCEPTED | EXPIRED
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model ApiKey {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  clinicName  String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model PairingInvite {
  id              String    @id @default(cuid())
  senderId        String
  sender          User      @relation("SentPairingInvites", fields: [senderId], references: [id])
  recipientEmail  String
  token           String    @unique
  status          String    @default("PENDING") // PENDING | ACCEPTED | REVOKED | EXPIRED
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  acceptedAt      DateTime?
}
