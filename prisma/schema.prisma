// ReproAI data model. No seed/mock data is provided; the database starts empty.
// Role and FollowUpStatus are stored as plain String columns. Valid values:
// Role = "PATIENT" | "CLINICIAN";
// FollowUpStatus = "ALERT_RAISED" | "CONSULTATION_REQUESTED" | "APPOINTMENT_SUGGESTED" |
//                  "APPOINTMENT_SCHEDULED" | "IN_FOLLOW_UP" | "APPOINTMENT_CANCELLED" | "CLOSED" | "LOST"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  /// One of: PATIENT | CLINICIAN
  role      String
  consentAt DateTime?
  createdAt DateTime @default(now())
  couple    Couple?  @relation(fields: [coupleId], references: [id])
  coupleId  String?

  // Individual-First architecture relations
  patientProfile      Patient?
  observations        Observation[]
  predictions         Prediction[]
  careNotifications   CareNotification[]
  sentPairingInvites  PairingInvite[] @relation("SentPairingInvites")
  labResults          LabResult[]
  consents            Consent[]
  conversations       ChatConversation[]
}

model Couple {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  users        User[]
  patients     Patient[]
  predictions  Prediction[]
  observations Observation[]
  followUps    FollowUp[]
  invitations  Invitation[]
}

/// Durable in-app notifications. Push subscriptions are intentionally not
/// modeled until a delivery provider is configured.
model CareNotification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String
  url       String   @default("/patient/overview")
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt, createdAt])
}

model Patient {
  id        String   @id @default(cuid())
  // Individual owner link
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  // Optional shared couple link (when paired)
  coupleId  String?
  couple    Couple?  @relation(fields: [coupleId], references: [id])

  name      String?
  // Clinical attributes used by the model
  sex             String?  // "female" | "male"
  age             Int?
  bmi             Float?
  amh             Float?
  spermCount      Float?
  pcosHistory     Boolean?
  infertilityDurationMonths Int?
  priorCycles     Int?
  antralFollicleCount       Int?
  cycleRegularity           String? // "REGULAR" | "IRREGULAR" | "AMENORRHEA"
  preservationIntent        Boolean? @default(false)
  // Self-reported intake (provenance: SELF_REPORTED)
  tryingToConceive          Boolean?
  smoking                   String?  // "NEVER" | "FORMER" | "CURRENT"
  /// JSON array of history flags, e.g. ["ENDOMETRIOSIS","PELVIC_SURGERY","CHEMOTHERAPY"]
  historyFlags              String?
  familyEarlyMenopause      Boolean?
  intakeCompletedAt         DateTime?
  createdAt       DateTime @default(now())
}

model Observation {
  id        String   @id @default(cuid())
  // Individual owner
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  // Optional couple association
  coupleId  String?
  couple    Couple?  @relation(fields: [coupleId], references: [id])

  // FHIR-aligned: code + value + unit (e.g. body temperature, sleep hours)
  code      String
  value     Float
  unit      String?
  effectiveAt DateTime @default(now())
  /// Provenance: MANUAL | BLUETOOTH | HEALTH_CONNECT | HEALTHKIT | ULTRAHUMAN. Null = recorded before provenance was tracked.
  source     String?
  /// Device or app that produced the reading, e.g. "Easy@Home BBT" or "Oura (via Health Connect)"
  device     String?
  /// Stable id from the source (HealthKit UUID, Health Connect id, device+timestamp) used to skip duplicates on re-import
  externalId String?

  @@unique([userId, source, externalId])
}

model Prediction {
  id            String   @id @default(cuid())
  // Individual owner
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  // Optional couple association
  coupleId      String?
  couple        Couple?  @relation(fields: [coupleId], references: [id])

  scope         String   @default("COUPLE") // "INDIVIDUAL" | "COUPLE"
  probability   Float
  confidenceLow Float?
  confidenceHigh Float?
  tier          String?  // "OPTIMAL" | "AGE_APPROPRIATE" | "REDUCED_RESERVE" | "CLINICAL_ATTENTION_NEEDED"
  preservationGuidance String?
  // JSON string of feature importances returned by the ML service
  factors       String?
  modelVersion  String?
  /// DRAFT (awaiting clinician review) | RELEASED (visible to the patient)
  status        String   @default("RELEASED")
  completeness  Float?
  /// AMH-for-age percentile (female individual assessments)
  percentile    Float?
  /// JSON of the inputs used, with provenance
  inputs        String?
  /// JSON array of optional inputs that were missing
  missingOptional String?
  evidenceStatus String?
  createdById   String?
  reviewedById  String?
  reviewedAt    DateTime?
  clinicianNote String?
  createdAt     DateTime @default(now())
}

/// Laboratory / ultrasound results with provenance.
model LabResult {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  /// AMH | AFC | FSH | SPERM_CONCENTRATION | SPERM_TOTAL_MOTILITY | SPERM_PROGRESSIVE_MOTILITY | SPERM_MORPHOLOGY | SEMEN_VOLUME
  code        String
  value       Float
  unit        String
  collectedAt DateTime
  /// CLINICIAN_VERIFIED | SELF_REPORTED | IMPORTED
  source      String
  enteredById String
  createdAt   DateTime @default(now())

  @@index([userId, code])
}

/// Granular, revocable consent per purpose.
model Consent {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  /// LAB_RESULTS | WEARABLES | PARTNER_SHARING | CLINICIAN_ACCESS | POPULATION_ANALYTICS
  purpose   String
  granted   Boolean
  grantedAt DateTime?
  revokedAt DateTime?
  updatedAt DateTime  @updatedAt

  @@unique([userId, purpose])
}

model FollowUp {
  id        String         @id @default(cuid())
  couple    Couple         @relation(fields: [coupleId], references: [id])
  coupleId  String
  /// One of: ALERT_RAISED | CONSULTATION_REQUESTED | APPOINTMENT_SUGGESTED |
  /// APPOINTMENT_SCHEDULED | IN_FOLLOW_UP | APPOINTMENT_CANCELLED | CLOSED | LOST
  status    String @default("ALERT_RAISED")
  note      String?
  updatedAt DateTime       @updatedAt
  createdAt DateTime       @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  resource  String
  createdAt DateTime @default(now())
}

model Invitation {
  id           String    @id @default(cuid())
  coupleId     String
  couple       Couple    @relation(fields: [coupleId], references: [id])
  scope        String    @default("COUPLE") // INDIVIDUAL | COUPLE
  email        String?   // primary or individual email
  partnerEmail String?   // optional partner email
  sex          String?   // female | male
  name         String?   // patient name
  femaleEmail  String?   // preserved for legacy compatibility
  maleEmail    String?
  token        String    @unique
  notes        String?
  invitedBy    String    // Clinician userId
  status       String    @default("PENDING") // PENDING | ACCEPTED | EXPIRED
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
}

model ApiKey {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  clinicName  String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model PairingInvite {
  id              String    @id @default(cuid())
  senderId        String
  sender          User      @relation("SentPairingInvites", fields: [senderId], references: [id])
  recipientEmail  String
  token           String    @unique
  status          String    @default("PENDING") // PENDING | ACCEPTED | REVOKED | EXPIRED
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  acceptedAt      DateTime?
}

// Assistant chat history ("recent conversations"). Private to the user who
// asked: every read and delete is scoped by userId from the session. Each turn
// stores the full GroundedAnswer JSON so a reopened chat re-renders its
// citations without calling the LLM again.
model ChatConversation {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// One of: PATIENT_ASSISTANT | CLINICIAN_COPILOT
  assistant String
  /// Clinician copilot only: the care case (Couple.id) the chat was about.
  caseId    String?
  title     String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  turns     ChatTurn[]

  @@index([userId, assistant, updatedAt])
}

model ChatTurn {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  question       String
  /// Plain-text reply as shown (answerText or the scripted summary).
  reply          String
  provider       String?
  /// The GroundedAnswer returned by src/lib/rag/answer.ts, stored verbatim.
  answer         Json?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}
