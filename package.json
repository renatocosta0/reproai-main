{
  "name": "reproai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "demo:setup": "ts-node --project prisma/tsconfig.scripts.json prisma/demo.ts",
    "rag:eval": "TS_NODE_PROJECT=scripts/tsconfig.json ts-node -r tsconfig-paths/register scripts/rag-eval.ts",
    "mobile:build": "node scripts/build-mobile-next.mjs",
    "mobile:sync": "npm run mobile:build && cap sync",
    "mobile:android": "npm run mobile:build && cap run android",
    "mobile:ios": "npm run mobile:build && cap run ios"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capgo/capacitor-health": "^8.13.0",
    "@prisma/client": "5.17.0",
    "bcryptjs": "2.4.3",
    "jose": "5.6.3",
    "lucide-react": "^0.511.0",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^20.19.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.40",
    "prisma": "5.17.0",
    "tailwindcss": "3.4.7",
    "ts-node": "^10.9.2",
    "vite": "^7.3.8",
    "typescript": "5.5.4",
    "vitest": "^4.1.12"
  }
}
