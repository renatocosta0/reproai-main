        <mxCell id="e-rag-llm" value="PASSAGES + RECORD FACTS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4F5D75;strokeWidth=1.8;endArrow=block;endFill=1;fontSize=9;fontFamily=Geist Mono;fontColor=#5A6580;" edge="1" parent="1" source="node-4d" target="card-sovereign"><mxGeometry relative="1" as="geometry"><mxPoint x="1330" y="435" as="sourcePoint"/><mxPoint x="1480" y="435" as="targetPoint"/></mxGeometry></mxCell>
