<mxfile host="app.diagrams.net" agent="ReproAI" version="24.7.17" type="device">
  <diagram id="reproai-architecture" name="ReproAI Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Header -->
        <mxCell id="hdr-title" value="SYSTEM ARCHITECTURE · CLINICAL GOVERNANCE &amp; HONEST LIMITS" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;fontSize=13;fontFamily=Geist Mono;fontStyle=1;fontColor=#2D3142;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="550" height="20" as="geometry"/>
        </mxCell>

        <!-- Stage 1 -->
        <mxCell id="lbl-stg1" value="1 · WHAT GOES IN (CLINICAL INTAKE)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Geist Mono;fontColor=#5A6580;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="300" height="15" as="geometry"/>
        </mxCell>
        <mxCell id="node-1a" value="&lt;b&gt;Person &amp;amp; partner&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6580;font-family:Geist Mono&quot;&gt;Self-reported intake · Menstrual history · Partner pairing&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#4F5D75;fontSize=14;fontColor=#2D3142;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="85" width="425" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="node-1b" value="&lt;b&gt;Certified clinician&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6580;font-family:Geist Mono&quot;&gt;Assigned cases only · Scope isolation · Lab verification&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#4F5D75;fontSize=14;fontColor=#2D3142;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="507" y="85" width="425" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="node-1c" value="&lt;b&gt;The record: diagnostic labs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6580;font-family:Geist Mono&quot;&gt;AMH, AFC, Semen, Ultrasound · Dated with clinical source&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#4F5D75;fontSize=14;fontColor=#2D3142;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="954" y="85" width="486" height="74" as="geometry"/>
        </mxCell>

        <!-- Stage 2 -->
        <mxCell id="lbl-stg2" value="2 · BEFORE ANYTHING IS READ (PRIVACY GATE)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Geist Mono;fontColor=#5A6580;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="350" height="15" as="geometry"/>
        </mxCell>
        <mxCell id="node-2" value="&lt;b&gt;Consent gate (5 granular purposes)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6580;font-family:Geist Mono&quot;&gt;Care team · Lab results · Wearables · Partner · Anonymous statistics · Revocable anytime&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#4F5D75;fontSize=14;fontColor=#2D3142;align=left;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="350" y="185" width="740" height="66" as="geometry"/>
        </mxCell>

        <!-- Stage 3 (Dark) -->
        <mxCell id="lbl-stg3" value="3 · THE PIPELINE — WHERE AN ESTIMATE IS FORMED" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Geist Mono;fontColor=#5A6580;" vertex="1" parent="1">
          <mxGeometry x="60" y="268" width="400" height="15" as="geometry"/>
        </mxCell>
        <mxCell id="node-3" value="&lt;b&gt;The assessment pipeline &amp;amp; missing-data gate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#DCDCDE;font-family:Geist Mono&quot;&gt;Checks completeness · Rejects with &#x27;insufficient_data&#x27; if key biomarkers missing · Zero silent imputation&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#2D3142;strokeColor=#2D3142;fontSize=15;fontColor=#FFFFFF;align=left;spacingLeft=25;" vertex="1" parent="1">
          <mxGeometry x="250" y="284" width="940" height="76" as="geometry"/>
        </mxCell>

        <!-- Stage 4 -->
        <mxCell id="lbl-stg4" value="4 · THE COMPONENTS (EXPLAINABLE ML + GROUNDED RAG)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Geist Mono;fontColor=#5A6580;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="450" height="15" as="geometry"/>
        </mxCell>
        <mxCell id="node-4a" value="&lt;b&gt;Deterministic scorer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6580;font-family:Geist Mono&quot;&gt;Literature-spline v2.2 (FastAPI)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4F5D75&quot;&gt;Hand-set · not validated · No LLM&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#4F5D75;fontSize=13;fontColor=#2D3142;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="408" width="295" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="node-4b" value="&lt;b&gt;Explainer (Shapley)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6580;font-family:Geist Mono&quot;&gt;Per-factor contribution vs reference&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4F5D75&quot;&gt;Model-based 95% interval · not validated&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#4F5D75;fontSize=13;fontColor=#2D3142;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="380" y="408" width="295" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="node-4c" value="&lt;b&gt;Pathway rules&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6580;font-family:Geist Mono&quot;&gt;Thiqa · WHO · ESHRE · POSEIDON&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4F5D75&quot;&gt;Deterministic · every option has a rule ID&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#4F5D75;fontSize=13;fontColor=#2D3142;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="700" y="408" width="295" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="node-4d" value="&lt;b&gt;Guidance retrieval (RAG)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6580;font-family:Geist Mono&quot;&gt;Local BM25 · Azure AI Search optional&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4F5D75&quot;&gt;Daman Thiqa v3.6 · WHO · ESHRE&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#4F5D75;fontSize=13;fontColor=#2D3142;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="1020" y="408" width="310" height="88" as="geometry"/>
        </mxCell>

        <!-- Stage 5 -->
        <mxCell id="lbl-stg5" value="5 · WHAT COMES OUT — DRAFT STATUS ONLY" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Geist Mono;fontColor=#5A6580;" vertex="1" parent="1">
          <mxGeometry x="60" y="525" width="350" height="15" as="geometry"/>
        </mxCell>
        <mxCell id="node-5" value="&lt;b&gt;Draft assessment (status: DRAFT)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#5A6580;font-family:Geist Mono&quot;&gt;Model estimate + factors + cited options · deterministic draft note (no LLM)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4F5D75&quot;&gt;Stored with exact inputs and model version · invisible to patient until signed&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#4F5D75;fontSize=14;fontColor=#2D3142;align=left;spacingLeft=25;" vertex="1" parent="1">
          <mxGeometry x="330" y="544" width="780" height="78" as="geometry"/>
        </mxCell>

        <!-- Coral Gate -->
        <mxCell id="gate" value="HUMAN APPROVAL GATE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#BF4520;strokeColor=#BF4520;fontSize=11;fontFamily=Geist Mono;fontStyle=1;fontColor=#FFFFFF;align=center;" vertex="1" parent="1">
          <mxGeometry x="620" y="646" width="200" height="34" as="geometry"/>
        </mxCell>

        <!-- Stage 6 (Dark) -->
        <mxCell id="lbl-stg6" value="6 · THE CLINICAL DECISION" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Geist Mono;fontColor=#5A6580;" vertex="1" parent="1">
          <mxGeometry x="60" y="692" width="250" height="15" as="geometry"/>
        </mxCell>
        <mxCell id="node-6" value="&lt;b&gt;Clinician reviews &amp;amp; decides&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#DCDCDE;font-family:Geist Mono&quot;&gt;Reads the draft · Checks inputs and provenance · Writes mandatory clinical note · Releases, or discards with reason&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#2D3142;strokeColor=#2D3142;fontSize=15;fontColor=#FFFFFF;align=left;spacingLeft=25;" vertex="1" parent="1">
          <mxGeometry x="230" y="704" width="980" height="80" as="geometry"/>
        </mxCell>

        <!-- Stage 7 -->
        <mxCell id="lbl-stg7" value="7 · WHAT A PERSON CAN SEE &amp;amp; INTEROPERABILITY" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Geist Mono;fontColor=#5A6580;" vertex="1" parent="1">
          <mxGeometry x="60" y="802" width="400" height="15" as="geometry"/>
        </mxCell>
        <mxCell id="node-7a" value="&lt;b&gt;Draft store &amp;amp; record&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6580;font-family:Geist Mono&quot;&gt;PostgreSQL · Prisma · provenance on every value&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4F5D75&quot;&gt;AES-256-GCM on sensitive text fields · labs not yet&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#4F5D75;fontSize=14;fontColor=#2D3142;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="834" width="425" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="node-7b" value="&lt;b&gt;Patient portal &amp;amp; AI assistant&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6580;font-family:Geist Mono&quot;&gt;Bilingual EN / AR (RTL) · Grounded Q&amp;amp;A&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4F5D75&quot;&gt;Answers from released record + cited guidance · abstains when unsure&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#4F5D75;fontSize=14;fontColor=#2D3142;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="507" y="834" width="425" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="node-7c" value="&lt;b&gt;HL7 FHIR R4 interoperability&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6580;font-family:Geist Mono&quot;&gt;FHIR R4 export runs · Malaffi import proposed&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4F5D75&quot;&gt;Patient · Observation · RiskAssessment&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#4F5D75;fontSize=14;fontColor=#2D3142;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="954" y="834" width="486" height="82" as="geometry"/>
        </mxCell>

        <!-- Right: Sovereign AI & LLM Foundry (Unified Card) -->
        <mxCell id="card-sovereign" value="&lt;b style=&quot;color:#A8641A;font-family:Geist Mono&quot;&gt;HOSTING &amp;amp; DATA RESIDENCY&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Prototype today (synthetic data only)&lt;/b&gt;&lt;br&gt;App on Vercel · Postgres on Neon (US)&lt;br&gt;LLM: Azure OpenAI gpt-5-mini, UAE North · Groq (US) fallback&lt;br&gt;&lt;br&gt;&lt;b&gt;Production: UAE residency (proposed)&lt;/b&gt;&lt;br&gt;Move app, DB and scoring to Azure UAE North&lt;br&gt;No non-UAE fallback · DoH Standard 3.1.4.5.1&lt;br&gt;&lt;br&gt;&lt;b&gt;Before any real patient data&lt;/b&gt;&lt;br&gt;Managed keys · MFA · ADHICS · DoH review&lt;br&gt;&lt;hr&gt;&lt;br&gt;&lt;b style=&quot;color:#A8641A;font-family:Geist Mono&quot;&gt;WHAT THE LLM DOES (AND DOES NOT)&lt;/b&gt;&lt;br&gt;Words answers from retrieved, cited passages only&lt;br&gt;Every sentence cited, verified, or dropped&lt;br&gt;&lt;span style=&quot;color:#BF4520&quot;&gt;&lt;b&gt;Never computes a number or takes an action&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#A8641A;dashed=1;dashPattern=4 4;fontSize=12;fontColor=#2D3142;align=left;spacingLeft=20;verticalAlign=top;spacingTop=20;" vertex="1" parent="1">
          <mxGeometry x="1480" y="82" width="380" height="426" as="geometry"/>
        </mxCell>

        <!-- Bottom Bar (Dark) -->
        <mxCell id="bottom-bar" value="&lt;b style=&quot;font-family:Geist Mono;font-size:12px&quot;&gt;ALL LAYERS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#DCDCDE;font-size:13px&quot;&gt;Consent checked per purpose · Every access written to audit log · AES-256-GCM on sensitive fields · Zero silent imputation · Synthetic data only&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#2D3142;strokeColor=#2D3142;fontSize=13;fontColor=#FFFFFF;align=left;spacingLeft=30;" vertex="1" parent="1">
